// Lambda@Edge viewer-request: send viewers without the JWT cookie to the API's login
// entrypoint, which issues the OAuth `state` before redirecting to the Cognito Hosted UI.
// No process.env at edge — keep this file free of runtime configuration.
'use strict';

exports.handler = async (event) => {
  const request = event.Records[0].cf.request;
  const headers = request.headers;
  const cookieHeader = headers.cookie ? headers.cookie[0].value : '';
  const hasIdToken = /(?:^|;\s*)mfg_id_token=/.test(cookieHeader);

  // login / callback / logout / whoami authenticate (or not) on their own.
  if (request.uri.startsWith('/api/auth/')) {
    return request;
  }

  if (!hasIdToken) {
    return {
      status: '302', statusDescription: 'Found',
      headers: { location: [{ key: 'Location', value: '/api/auth/login' }] },
    };
  }
  return request;
};
